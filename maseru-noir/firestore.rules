rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only authorized team members can access the HQ data
    function isAuthorized() {
      return request.auth != null && 
             (request.auth.token.email == 'andy@outworld.hq' || 
              request.auth.token.email == 'dremoon@outworld.hq');
    }

    match /users/{userId}/metadata {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAuthorized();
    }

    match /outcomes/{outcomeId} {
      allow read, write: if isAuthorized();
    }

    match /brand_vault/{documentId} {
      allow read, write: if isAuthorized();
    }
  }
}
